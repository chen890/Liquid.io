# EquityLens — environment variables template
# Copy to .env and fill in your values.

# ── Cursor SDK (preferred) ───────────────────────────────────────────────────
# Format: cursor_...   Source: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=cursor_...

# ── OpenAI (fallback) ────────────────────────────────────────────────────────
# Used automatically when CURSOR_API_KEY is absent or fails
OPENAI_API_KEY=sk-...

# ── Extraction server ────────────────────────────────────────────────────────
EXTRACTION_SERVER_PORT=3712

# ── Vite (frontend) ─────────────────────────────────────────────────────────
VITE_EXTRACTION_SERVER_PORT=3712

# ── User auth & encrypted vault (FastAPI) ───────────────────────────────────
# CORS: comma-separated browser origins that may send cookies (include your deployed SPA origin).
# CORS_ORIGINS=http://localhost:5173,https://your-app.example.com

# JWT signing secret for session cookies (or set JWT_SECRET_FILE to a file path).
# JWT_SECRET=

# Fernet key for encrypting vault blobs at rest (44-char url-safe base64), or APP_ENCRYPTION_KEY_FILE.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=

# Optional: SQLite path (default: <repo>/data/users.db)
# USER_DB_PATH=

# Max upload size per vault file in MB (default 25)
# VAULT_MAX_FILE_MB=25

# Session lifetime in minutes (default 10080 = 7 days)
# JWT_ACCESS_MINUTES=10080
