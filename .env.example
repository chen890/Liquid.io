# EquityLens — environment variables template
# Copy to .env and fill in your values.

# ── Meezeh / Sofia (preferred extraction backend) ────────────────────────────
# Meezeh credentials obtain a bearer token for Sofia's OpenAI-compatible API.
# Format: short_username@mobileye.com
MEEZEH_USERNAME=
MEEZEH_PASSWORD=

# OpenAI-compatible endpoint. Default is correct for most users.
SOFIA_BASE_URL=https://sofia-api.lgw.cloud.mobileye.com/v1/api
SOFIA_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0

# Pre-obtained Sofia token — skips Meezeh auth when set (valid ~50 min).
# SOFIA_API_KEY=

# ── OpenAI (fallback) ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (Claude) — fallback when Sofia is unavailable ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── xAI Grok — fallback when Sofia is unavailable ────────────────────────────
# GROK_API_KEY=xai-...
# XAI_API_KEY=xai-...   # alias for GROK_API_KEY

# Optional overrides (defaults: gpt-4o, claude-sonnet-4-20250514, grok-3-latest)
# OPENAI_EXTRACTION_MODEL=gpt-4o
# ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-20250514
# GROK_EXTRACTION_MODEL=grok-3-latest

# ── Extraction server ────────────────────────────────────────────────────────
EXTRACTION_SERVER_PORT=3712

# ── Vite (frontend) ─────────────────────────────────────────────────────────
VITE_EXTRACTION_SERVER_PORT=3712

# ── User auth & encrypted vault (FastAPI) ───────────────────────────────────
# CORS: comma-separated browser origins that may send cookies (include your deployed SPA origin).
# CORS_ORIGINS=http://localhost:5173,https://your-app.example.com

# JWT signing secret for session cookies (or set JWT_SECRET_FILE to a file path).
# JWT_SECRET=

# Fernet key for encrypting vault blobs at rest (44-char url-safe base64), or APP_ENCRYPTION_KEY_FILE.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENCRYPTION_KEY=

# Optional: SQLite path (default: <repo>/data/users.db)
# USER_DB_PATH=

# Max upload size per vault file in MB (default 25)
# VAULT_MAX_FILE_MB=25

# Session lifetime in minutes (default 10080 = 7 days)
# JWT_ACCESS_MINUTES=10080

# ── OAuth (Google / GitHub) ─────────────────────────────────────────────────
# Public URL of the SPA (no trailing slash). OAuth redirect_uri is built as:
#   {FRONTEND_PUBLIC_URL}/api/auth/oauth/{google|github}/callback
# Register that exact URL in Google Cloud Console + GitHub OAuth App settings.
FRONTEND_PUBLIC_URL=http://localhost:5173

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
